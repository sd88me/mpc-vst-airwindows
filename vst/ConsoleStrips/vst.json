   "vendor/airwin2rack/src/airwin_consolidated_base.cpp",
   "src/gen/fac/ConsoleHChannel.cpp",
   "src/gen/fac/ConsoleHPre.cpp",
   "src/gen/fac/ConsoleX2Channel.cpp",
   "src/gen/fac/ConsoleX2Pre.cpp",
   "src/gen/fac/ConsoleX3.cpp",
   "src/gen/fac/ConsoleXBuss.cpp",
   "src/gen/fac/ConsoleXChannel.cpp",
   "src/gen/fac/ConsoleXPre.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleHChannel.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleHChannelProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleHPre.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleHPreProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleX2Channel.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleX2ChannelProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleX2Pre.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleX2PreProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleX3.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleX3Proc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleXBuss.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleXBussProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleXChannel.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleXChannelProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleXPre.cpp",
   "vendor/airwin2rack/src/autogen_airwin/ConsoleXPreProc.cpp"
  ],
  "cflags": [
   "-std=gnu++17",
   "-Isrc",
   "-Ivendor/airwin2rack/src",
   "-w",
   "-O2",
   "-DAW_SLOTS=56"
  ],
  "libs": [
   "-lm"
  ],
  "cflags_arm": [
   "-mfpu=neon"
  ]
 }
}