   "vendor/airwin2rack/src/autogen_airwin/BiquadTriple.cpp",
   "vendor/airwin2rack/src/autogen_airwin/BiquadTripleProc.cpp",
   "vendor/airwin2rack/src/autogen_airwin/Biquad2.cpp",
   "vendor/airwin2rack/src/autogen_airwin/Biquad2Proc.cpp"
  ],
  "cflags": [
   "-std=gnu++17",
   "-Isrc",
   "-Ivendor/airwin2rack/src",
   "-w",
